{
  "formats": {
    "jpg": {
      "quality": 80,
      "progressive": true,
      "removeMetadata": true
    },
    "png": {
      "quality": 9,
      "removeMetadata": true
    },
    "gif": {
      "optimizationLevel": 3,
      "removeMetadata": true
    },
    "svg": {
      "minify": true
    }
  },
  "convertTo": {
    "webp": {
      "enabled": false,
      "quality": 80
    },
    "avif": {
      "enabled": false,
      "quality": 60
    }
  },
  "output": {
    "preserveStructure": true,
    "suffix": ""
  }
}
